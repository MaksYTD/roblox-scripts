local function updatePlayerEsp()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
    local myPos = myRoot and myRoot.Position or Vector3.zero
    
    local vp = Camera.ViewportSize
    local screenBottom = Vector2.new(vp.X / 2, vp.Y)
    
    for player, item in pairs(espObjects) do
        if not (player and player.Parent and player.Character and player.Character.Parent) then
            if item.Highlight and item.Highlight.Parent then item.Highlight:Destroy() end
            if item.Billboard and item.Billboard.Parent then item.Billboard:Destroy() end
            espObjects[player] = nil
        end
    end
    
    for player, line in pairs(tracerObjects) do
        if not (player and player.Parent and player.Character and player.Character.Parent and espMasterEnabled and espShowTracers) then
            pcall(function() line.Visible = false end)
        end
    end
    
    if not espMasterEnabled then
        cleanupEsp()
        return
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
            local head = char:FindFirstChild("Head") or root
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if root and head then
                if not espObjects[player] then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "ESP_Highlight"
                    highlight.FillColor = Color3.fromRGB(0, 180, 255)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    highlight.Adornee = char
                    highlight.Parent = char
                    
                    local bbg = Instance.new("BillboardGui")
                    bbg.Name = "ESP_Billboard"
                    bbg.Adornee = head
                    bbg.Size = UDim2.new(0, 200, 0, 60)
                    bbg.StudsOffset = Vector3.new(0, 2.5, 0)
                    bbg.AlwaysOnTop = true
                    bbg.Parent = head
                    
                    local tagLabel = Instance.new("TextLabel")
                    tagLabel.Name = "Tag"
                    tagLabel.Size = UDim2.new(1, 0, 1, 0)
                    tagLabel.BackgroundTransparency = 1
                    tagLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    tagLabel.TextStrokeTransparency = 0
                    tagLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    tagLabel.TextSize = 12
                    tagLabel.Font = Enum.Font.GothamBold
                    tagLabel.TextYAlignment = Enum.TextYAlignment.Bottom
                    tagLabel.Parent = bbg
                    
                    espObjects[player] = {
                        Highlight = highlight,
                        Billboard = bbg,
                        Label = tagLabel
                    }
                else
                    local item = espObjects[player]
                    if item.Highlight.Adornee ~= char then
                        item.Highlight.Adornee = char
                        item.Highlight.Parent = char
                    end
                    if item.Billboard.Adornee ~= head then
                        item.Billboard.Adornee = head
                        item.Billboard.Parent = head
                    end
                end
                
                local infoText = ""
                if espShowNames then
                    infoText = infoText .. player.DisplayName .. " (@" .. player.Name .. ")"
                end
                
                if espShowHealth and hum then
                    local hp = math.floor(hum.Health)
                    local maxHp = math.floor(hum.MaxHealth)
                    if infoText ~= "" then infoText = infoText .. "\n" end
                    infoText = infoText .. "[HP: " .. tostring(hp) .. "/" .. tostring(maxHp) .. "]"
                end
                
                if espShowDist then
                    local dist = math.floor((root.Position - myPos).Magnitude)
                    if infoText ~= "" then infoText = infoText .. " " end
                    infoText = infoText .. "[" .. tostring(dist) .. "m]"
                end
                
                if espShowTool then
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        if infoText ~= "" then infoText = infoText .. "\n" end
                        infoText = infoText .. "[Tool: " .. tostring(tool.Name) .. "]"
                    end
                end
                
                local item = espObjects[player]
                if item and item.Label then
                    item.Label.Text = infoText
                end
                
                if espShowTracers then
                    if not tracerObjects[player] and Drawing then
                        pcall(function()
                            local l = Drawing.new("Line")
                            l.Thickness = 1.5
                            l.Color = Color3.fromRGB(0, 180, 255)
                            l.Transparency = 1
                            tracerObjects[player] = l
                        end)
                    end
                    
                    local line = tracerObjects[player]
                    if line then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                        if onScreen then
                            line.From = screenBottom
                            line.To = Vector2.new(screenPos.X, screenPos.Y)
                            line.Visible = true
                        else
                            line.Visible = false
                        end
                    end
                else
                    if tracerObjects[player] then
                        tracerObjects[player].Visible = false
                    end
                end
            end
        end
    end
end

local function toggleToggleCard(badge, stroke, state)
    if state then
        badge.Text = "ON"
        badge.TextColor3 = Color3.fromRGB(255, 255, 255)
        badge.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
        stroke.Color = Color3.fromRGB(0, 180, 100)
    else
        badge.Text = "OFF"
        badge.TextColor3 = Color3.fromRGB(150, 160, 180)
        badge.BackgroundColor3 = Color3.fromRGB(35, 40, 55)
        stroke.Color = Color3.fromRGB(40, 45, 65)
    end
end

