local function toggleUI(state)
    if state == nil then state = not isGuiOpen end
    isGuiOpen = state
    
    local targetSize = isGuiOpen and UDim2.new(0, 370, 0, 480) or UDim2.new(0, 0, 0, 0)
    local targetPos = isGuiOpen and UDim2.new(0.5, -185, 0.5, -240) or UDim2.new(0.5, 0, 0.5, 0)
    
    MainFrame.Visible = true
    local tween = TweenService:Create(MainFrame, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = targetSize,
        Position = targetPos
    })
    tween:Play()
    
    if not isGuiOpen then
        tween.Completed:Connect(function()
            if not isGuiOpen then MainFrame.Visible = false end
        end)
    end
end

HideBtn.MouseButton1Click:Connect(function() toggleUI(false) end)
ToggleButton.MouseButton1Click:Connect(function() toggleUI() end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == TOGGLE_KEY then
        toggleUI()
    end
end)

local function makeDraggable(frame)
    local dragging, dragInput, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

makeDraggable(MainFrame)
makeDraggable(ToggleButton)

local function unloadScript()
    if loopTpConnection then loopTpConnection:Disconnect() loopTpConnection = nil end
    if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
    if clickTpConnection then clickTpConnection:Disconnect() clickTpConnection = nil end
    if infJumpConnection then infJumpConnection:Disconnect() infJumpConnection = nil end
    if espConnection then espConnection:Disconnect() espConnection = nil end
    
    for _, highlight in pairs(espObjects) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end
    espObjects = {}
    
    if isSpectating and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then workspace.CurrentCamera.CameraSubject = hum end
    end
    
    ScreenGui:Destroy()
    
    StarterGui:SetCore("SendNotification", {
        Title = "Dark Quiet Community",
        Text = "Script unloaded successfully.",
        Duration = 3
    })
end

